#!/bin/sh
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if [ "$branch" != "zur-test" ]; then
    exit 0
fi

if ! git fetch upstream --prune --quiet 2>/dev/null; then
    echo "pre-push: could not fetch upstream (offline?) - push allowed"
    exit 0
fi

if git merge-base --is-ancestor upstream/zur-test HEAD 2>/dev/null; then
    exit 0
fi

if git merge-base --is-ancestor HEAD upstream/zur-test 2>/dev/null; then
    if git merge --ff-only upstream/zur-test --quiet 2>/dev/null; then
        echo "pre-push: auto-synced zur-test with upstream."
        echo "pre-push: run 'git push' again."
    else
        echo "pre-push: update blocked by local edits."
        echo "pre-push: commit or stash them, then run 'git pull --rebase'."
    fi
    exit 1
fi

echo "pre-push: local and upstream/zur-test have diverged."
echo "pre-push: run 'git pull --rebase', resolve conflicts, then push again."
exit 1
